---
import '../styles/global.css';
import { getImage, Font } from 'astro:assets';
import site from '../data/site.json';
import logo from '../assets/el-rodeo-grill-logo.png';
import cortes from '../data/cortes.json';
import menu from '../data/menu.json';

interface Props { title: string; description: string }
const { title, description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Rutas de public/ con el base de Pages (import.meta.env.BASE_URL termina en /).
const ogImage = new URL(`${import.meta.env.BASE_URL}og.jpg`, Astro.site);
const favicon = await getImage({ src: logo, width: 64, height: 64, format: 'png' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.nombre,
  description,
  url: canonical.href,
  image: ogImage.href,
  logo: ogImage.href,
  servesCuisine: ['Carnes a la parrilla', 'Asados'],
  telephone: `+${site.whatsapp}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.direccion,
    addressLocality: site.ciudad,
    addressCountry: site.pais,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.google.ratingValue,
    reviewCount: String(site.google.reviews),
    bestRating: '5',
  },
  acceptsReservations: true,
  priceRange: site.priceRange,
  // Horario publicado antes de la mudanza: PENDIENTE confirmar para el local nuevo.
  openingHoursSpecification: site.horario.franjas.map((f) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: f.schema.map((d) => `https://schema.org/${d}`),
    opens: f.abre,
    closes: f.cierra,
  })),
  hasMenu: {
    '@type': 'Menu',
    hasMenuSection: [
      {
        '@type': 'MenuSection',
        name: 'Cortes',
        hasMenuItem: cortes.cortes.flatMap((c) => c.tamanos.map((t) => ({
          '@type': 'MenuItem',
          name: t.nombre ? `${c.nombre} ${t.nombre.toLowerCase()}` : c.nombre,
          offers: { '@type': 'Offer', price: (t.precio / 100).toFixed(2), priceCurrency: 'USD' },
        }))),
      },
      {
        '@type': 'MenuSection',
        name: 'Menú del día y yahuarlocro',
        hasMenuItem: [...menu.menuDia.opciones, ...menu.yahuarlocro.opciones].map((o) => ({
          '@type': 'MenuItem',
          name: o.pedido,
          offers: { '@type': 'Offer', price: (o.precio / 100).toFixed(2), priceCurrency: 'USD' },
        })),
      },
    ],
  },
  sameAs: [site.instagram.url, site.facebook.url],
};
---
<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- DEMO: impide que Google indexe la vista previa. QUITAR al lanzar con el dominio definitivo (ver README). -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0e0907" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="icon" type="image/png" href={favicon.src} />
    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-yellowtail" preload />
    <Font cssVariable="--font-figtree" preload />

    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de El Rodeo Grill sobre fondo oscuro" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/animaciones';
    </script>
  </body>
</html>
