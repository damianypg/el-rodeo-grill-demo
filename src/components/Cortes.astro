---
import type { ImageMetadata } from 'astro';
import data from '../data/cortes.json';
import Icon from './Icon.astro';
import Foto from './Foto.astro';
import Precio from './Precio.astro';
import { waLink, waMensajes } from '../lib/wa';
import { formatoPrecio } from '../lib/precio';

const afiches = import.meta.glob<{ default: ImageMetadata }>('../assets/flyers/*.jpg', { eager: true });
const afiche = (nombre: string | null | undefined) => (nombre ? afiches[`../assets/flyers/${nombre}.jpg`]?.default : undefined);
---
<section id="cortes" class="madera seccion" aria-labelledby="cortes-titulo">
  <div class="contenedor">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="revelar">
        <p class="script text-script-xl -mb-1">A la parrilla</p>
        <h2 id="cortes-titulo" class="text-h2">Cortes estrella</h2>
      </div>
      <p class="revelar max-w-[40ch] text-hueso-50">{data.acompanantes} Elige el tamaño y pídelo directo, o súmalo a tu pedido.</p>
    </div>

    <!-- Móvil: carrusel horizontal con el siguiente corte asomando. Desde 768 px: rejilla. -->
    <p class="mt-6 text-[0.9375rem] font-semibold text-oro-300 md:hidden" aria-hidden="true">Desliza para ver los 6 cortes</p>
    <ul class="carrusel -mx-4 mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 md:mx-0 md:mt-10 md:grid md:snap-none md:grid-cols-2 md:gap-8 md:overflow-visible md:px-0 md:pb-0 xl:grid-cols-3">
      {data.cortes.map((c, i) => {
        const img = afiche(c.afiche);
        const primero = c.tamanos[0];
        const varios = c.tamanos.length > 1;
        return (
          <li class="revelar w-[84%] shrink-0 snap-center md:w-auto" style={`--i:${i % 3}`}>
            <article class="corte inclinable flex h-full flex-col overflow-hidden rounded-(--radius-tabla) bg-carbon-950 shadow-(--shadow-tabla) ring-1 ring-white/10" data-corte={c.id} data-nombre={c.nombre}>
              {img ? (
                <div class="corte-afiche mx-auto w-full" style={`max-width:${img.width}px`}>
                  <Foto src={img} alt={c.alt} sizes="(min-width: 1280px) 390px, (min-width: 768px) calc(50vw - 40px), calc(100vw - 32px)" />
                </div>
              ) : (
                /* Sin afiche: tarjeta tipográfica con la estética de los flyers (madera, fuego, nombre y precio). */
                <div class="madera relative isolate grid aspect-[547/612] place-items-center overflow-hidden px-6 text-center">
                  <div class="brasas bottom-[30%]" aria-hidden="true"></div>
                  <div class="flex flex-col items-center gap-5">
                    <p class="font-display text-[clamp(4rem,3rem+4vw,6rem)] leading-none text-white uppercase [text-shadow:0_4px_24px_rgb(0_0_0/.6)]" aria-hidden="true">{c.nombre}</p>
                    <Precio centavos={primero.precio} tamano="lg" data-contar />
                    <p class="max-w-[24ch] font-semibold text-hueso-50">{data.acompanantes}</p>
                  </div>
                </div>
              )}
              <div class="flex flex-1 flex-col gap-4 p-5 md:p-6">
                <h3 class="text-h3">{c.nombre}</h3>
                {varios ? (
                  <fieldset>
                    <legend class="mb-2 text-[0.875rem] font-semibold text-humo-300">Tamaño</legend>
                    <div class="flex flex-wrap gap-2">
                      {c.tamanos.map((t, j) => (
                        <label class="tamano relative cursor-pointer">
                          <input class="peer sr-only" type="radio" name={`tamano-${c.id}`} value={t.id} checked={j === 0} data-precio={t.precio} data-nombre={t.nombre} />
                          <span class="flex min-h-11 items-center gap-1.5 rounded-full border-2 border-cafe-600 px-4 font-semibold text-hueso-50 peer-checked:border-brasa-500 peer-checked:bg-brasa-500 peer-checked:text-carbon-950 peer-focus-visible:outline-3 peer-focus-visible:outline-offset-3 peer-focus-visible:outline-oro-300 hover:border-oro-300">
                            {t.nombre} <span class="font-normal">{formatoPrecio(t.precio)}</span>
                          </span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                ) : (
                  <p class="font-display text-[1.75rem] leading-none text-brasa-500">{formatoPrecio(primero.precio)}</p>
                )}
                <div class="mt-auto flex flex-wrap gap-2 pt-1">
                  <a class="btn btn-primary btn-sm" href={waLink(waMensajes.corte(c.nombre, varios ? primero.nombre : undefined))} target="_blank" rel="noopener" data-wa data-pedir-corte>
                    <Icon name="whatsapp" />Pedir este
                  </a>
                  <button type="button" class="btn btn-outline btn-sm" data-agregar-corte>Agregar al pedido</button>
                </div>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
    <p class="mt-6 text-[0.875rem] muted">Precios de nuestras publicaciones; te los confirmamos por WhatsApp.</p>
  </div>
</section>

<script>
  import { waLink, waMensajes } from '../lib/wa';

  // Al cambiar el tamaño se actualiza el texto del enlace "Pedir este".
  for (const card of document.querySelectorAll<HTMLElement>('.corte')) {
    const nombre = card.dataset.nombre!;
    card.addEventListener('change', (e) => {
      const radio = e.target as HTMLInputElement;
      if (radio.type !== 'radio') return;
      card.querySelector<HTMLAnchorElement>('[data-pedir-corte]')!.href = waLink(waMensajes.corte(nombre, radio.dataset.nombre));
    });
  }
</script>
