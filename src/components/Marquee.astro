---
// Cinta de cortes entre secciones. Decorativa: el contenido real está en las secciones.
import cortes from '../data/cortes.json';
const items = [...cortes.cortes.map((c) => c.nombre), '2x1 de lunes a jueves', 'Yahuarlocro los domingos', 'Menú del día'];
---
<div class="marquee border-y-2 border-oro-500/60 bg-carbon-950 py-3" aria-hidden="true">
  <div class="marquee-pista">
    {[0, 1].map(() => (
      <ul class="flex shrink-0 items-center">
        {items.map((t) => (
          <li class="flex items-center gap-6 px-6 font-display text-[1.375rem] tracking-wide whitespace-nowrap text-white uppercase md:text-2xl">
            {t}
            <svg viewBox="0 0 24 24" class="size-5 text-brasa-500" fill="currentColor"><path d="M12 2c1 4 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-5 1-9Z" /></svg>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee { overflow: hidden; }
  .marquee-pista { display: flex; width: max-content; }
  @media (prefers-reduced-motion: no-preference) {
    .marquee-pista { animation: desfilar 38s linear infinite; }
    .marquee:hover .marquee-pista { animation-play-state: paused; }
  }
  @keyframes desfilar { to { transform: translateX(-50%); } }
</style>
