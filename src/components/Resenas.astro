---
import site from '../data/site.json';
import resenas from '../data/resenas.json';
import Icon from './Icon.astro';
import { googleReviewsLink } from '../lib/wa';

const [a, b, c] = site.destacadosGoogle;
const citas = resenas.citas as { texto: string; autor: string; fuente: string }[];
---
<section id="resenas" class="madera-roja seccion" aria-labelledby="resenas-titulo">
  <div class="contenedor grid items-center gap-10 md:grid-cols-[auto_1fr] md:gap-16">
    <div class="flex items-center gap-6 md:flex-col md:items-start md:gap-3">
      <p class="font-display text-[clamp(6rem,4rem+8vw,10rem)] leading-[0.85] text-white">{site.google.rating}</p>
      <div>
        <p class="flex text-brasa-300" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="estrella" class="size-7" />)}</p>
        <p class="mt-1 font-semibold text-white">de 5 en Google<br />{site.google.reviews} reseñas</p>
      </div>
    </div>
    <div>
      <p class="script text-script-xl -mb-1">La gente vuelve</p>
      <h2 id="resenas-titulo" class="text-h2">Lo que más piden</h2>
      <p class="text-lead mt-5 max-w-[46ch] text-hueso-50">En Google se nombran sobre todo las {a}, el {b} y la {c}.</p>
      {citas.length > 0 && (
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {citas.map((q) => (
            <li>
              <figure class="h-full rounded-(--radius-tabla) bg-carbon-950/55 p-5 ring-1 ring-white/15">
                <blockquote class="text-hueso-50">“{q.texto}”</blockquote>
                <figcaption class="mt-3 text-[0.875rem] font-semibold text-oro-300">{q.autor}, en {q.fuente}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
      <a class="btn btn-outline mt-7" href={googleReviewsLink} target="_blank" rel="noopener">Leer las reseñas en Google</a>
    </div>
  </div>
</section>
